#version 430

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) writeonly uniform image2D outImage;
uniform ivec2 uResolution;

layout(std140, binding = 1) uniform Camera {
    vec4 pos;
    vec4 right;
    vec4 up;
    vec4 forward;
    float tanHalfFov;
    float aspect;
} cam;

struct Object {
    vec4 posRadius;
    vec4 color;
    vec4 massPad; 
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    Object obs[16];
};


vec2 geodesicDeriv(vec2 state) {
    return vec2(state.y, 1.5 * state.x * state.x - state.x);
}

vec2 rk4Step(vec2 state, float h) {
    vec2 k1 = geodesicDeriv(state);
    vec2 k2 = geodesicDeriv(state + 0.5 * h * k1);
    vec2 k3 = geodesicDeriv(state + 0.5 * h * k2);
    vec2 k4 = geodesicDeriv(state + h * k3);
    return state + (h / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= uResolution.x || pix.y >= uResolution.y) return;

    float su = (2.0 * float(pix.x) / float(uResolution.x) - 1.0) * cam.aspect * cam.tanHalfFov;
    float sv = (1.0 - 2.0 * float(pix.y) / float(uResolution.y)) * cam.tanHalfFov;
    vec3 dir = normalize(su * cam.right.xyz + sv * cam.up.xyz + cam.forward.xyz);

    vec3 bhPos = obs[0].posRadius.xyz;
    float rs   = obs[0].posRadius.w;

    vec3 p0 = cam.pos.xyz - bhPos;
    float r0 = length(p0);

    vec4 color = vec4(0.7, 0.7, 0.7, 1.0);

    vec3 angMom = cross(p0, dir);
    if (length(angMom) < 1e-6) {
       

        imageStore(outImage, pix, color);
        return;
    }

    vec3 planeN = normalize(angMom);
    vec3 e_r    = normalize(p0);
    vec3 e_phi  = normalize(cross(planeN, e_r));

    float cosPsi = dot(dir, e_r);
    float sinPsi = dot(dir, e_phi);
   
    float sgn = sinPsi >= 0.0 ? 1.0 : -1.0;
    sinPsi = sgn * max(abs(sinPsi), 1e-3);

    float U = rs / r0;
    float dUdphi = -U * (cosPsi / sinPsi);

    vec2 state = vec2(U, dUdphi);
    float phi = 0.0;
    const float dphi = 0.01;
    const int maxSteps = 3000;

    for (int i = 0; i < maxSteps; i++) {
        state = rk4Step(state, dphi);
        phi += dphi;

        float u = state.x;
        if (u >= 1.0) {
            color = vec4(0.0, 0.0, 0.0, 1.0);
            break;
        }
        if (u <= 1e-4 && state.y >= 0.0) {
            break;
        }

        float r = rs / max(u, 1e-6);
        vec3 pos = bhPos + r * (cos(phi) * e_r + sin(phi) * e_phi);

        bool hitObj = false;
        for (int j = 1; j < numObjects; j++) {
            float d = distance(pos, obs[j].posRadius.xyz);
            if (d < obs[j].posRadius.w) {
                vec3 n = normalize(pos - obs[j].posRadius.xyz);
                float shade = max(dot(n, -dir), 0.3);
                color = obs[j].color * shade;
                hitObj = true;
                break;
            }
        }
        if (hitObj) break;
    }

    imageStore(outImage, pix, color);
}
